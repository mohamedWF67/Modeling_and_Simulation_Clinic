<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Same palette as the OverlayOSD (Dynamic Flyout) light theme -->

    <!-- Window Colors -->
    <Color x:Key="WindowBackgroundColor">#F5F5F5</Color>
    <Color x:Key="TitleBarBackgroundColor">#E8E8E8</Color>
    <Color x:Key="CardBackgroundColor">#FFFFFF</Color>
    <Color x:Key="ControlBackgroundColor">#D0D0D0</Color>
    <Color x:Key="BorderColor">#CCCCCC</Color>

    <!-- Text Colors -->
    <Color x:Key="TextPrimaryColor">#1A1A1A</Color>
    <Color x:Key="TextSecondaryColor">#A51A1A1A</Color>
    <Color x:Key="TextMutedColor">#888888</Color>
    <Color x:Key="TextHighlightColor">#7F5F00</Color>
    <Color x:Key="AccentTextFillColorPrimary">#003e92</Color>
    <Color x:Key="AccentTextFillColorSecondary">#001a68</Color>
    <Color x:Key="AccentTextFillColorTertiary">#0067c0</Color>
    <Color x:Key="AccentTextFillColorDisabled">#9b9b9b</Color>

    <!-- Signals -->
    <Color x:Key="SystemFillColorSuccess">#0f7b0f</Color>
    <Color x:Key="SystemFillColorCaution">#9d5d00</Color>
    <Color x:Key="SystemFillColorCritical">#c42b1c</Color>
    <Color x:Key="SystemFillColorSuccessBackground">#dff6dd</Color>
    <Color x:Key="SystemFillColorCautionBackground">#fff4ce</Color>
    <Color x:Key="SystemFillColorCriticalBackground">#fde7e9</Color>

    <!-- Navigation View Pane -->
    <Color x:Key="NavigationViewPaneBackgroundColor">#F0F0F0</Color>

    <!-- Brushes -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="{StaticResource WindowBackgroundColor}" />
    <SolidColorBrush x:Key="TitleBarBackgroundBrush" Color="{StaticResource TitleBarBackgroundColor}" />
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="{StaticResource CardBackgroundColor}" />
    <SolidColorBrush x:Key="ControlBackgroundBrush" Color="{StaticResource ControlBackgroundColor}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}" />
    <SolidColorBrush x:Key="TextHighlightBrush" Color="{StaticResource TextHighlightColor}" />

    <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="{StaticResource AccentTextFillColorPrimary}" />
    <SolidColorBrush x:Key="AccentTextFillColorSecondaryBrush" Color="{StaticResource AccentTextFillColorSecondary}" />
    <SolidColorBrush x:Key="AccentTextFillColorTertiaryBrush" Color="{StaticResource AccentTextFillColorTertiary}" />
    <SolidColorBrush x:Key="AccentTextFillColorDisabledBrush" Color="{StaticResource AccentTextFillColorDisabled}" />

    <SolidColorBrush x:Key="SystemFillColorSuccessBrush" Color="{StaticResource SystemFillColorSuccess}" />
    <SolidColorBrush x:Key="SystemFillColorCautionBrush" Color="{StaticResource SystemFillColorCaution}" />
    <SolidColorBrush x:Key="SystemFillColorCriticalBrush" Color="{StaticResource SystemFillColorCritical}" />
    <SolidColorBrush x:Key="SystemFillColorSuccessBackgroundBrush" Color="{StaticResource SystemFillColorSuccessBackground}" />
    <SolidColorBrush x:Key="SystemFillColorCautionBackgroundBrush" Color="{StaticResource SystemFillColorCautionBackground}" />
    <SolidColorBrush x:Key="SystemFillColorCriticalBackgroundBrush" Color="{StaticResource SystemFillColorCriticalBackground}" />

    <!-- Navigation View brushes (override WPF-UI theme) -->
    <SolidColorBrush x:Key="NavigationViewPaneBackground" Color="{DynamicResource NavigationViewPaneBackgroundColor}" />
</ResourceDictionary>
