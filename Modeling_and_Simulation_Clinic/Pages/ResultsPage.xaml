<Page x:Class="Modeling_and_Simulation_Clinic.Pages.ResultsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:componentModel="clr-namespace:System.ComponentModel;assembly=PresentationFramework"
      xmlns:viewModels="clr-namespace:Modeling_and_Simulation_Clinic.ViewModels"
      xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
      xmlns:wpf="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
      xmlns:skiaSharpView="clr-namespace:LiveChartsCore.SkiaSharpView;assembly=LiveChartsCore.SkiaSharpView"
      mc:Ignorable="d"
      d:DataContext="{d:DesignInstance viewModels:statisticsViewModel}"
      d:DesignHeight="600"
      d:DesignWidth="800"
      Title="Results">
    <Grid>
        <Grid.Style>
            <Style TargetType="Grid">
                <Style.Triggers>
                    <Trigger Property="componentModel:DesignerProperties.IsInDesignMode" Value="True">
                        <Setter Property="Background" Value="Black"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
        </Grid.Style>
        <StackPanel Orientation="Vertical" Margin="16">
            <TextBlock Text="Results"
                       FontWeight="SemiBold" FontSize="24"
                       Margin="4,0,0,4"/>
            <TextBlock Opacity="0.65" Margin="4,0,0,12">
                <Run Text="Average of"/>
                <Run Text="{Binding RunCount, Mode=OneWay}"/>
                <Run Text="runs"/>
            </TextBlock>
            <TextBlock Text="Q1 Mean Exam Time"
                       FontWeight="SemiBold" FontSize="14"
                       Margin="4,0,0,4"/>
                <ui:Card>
                    <StackPanel Orientation="Vertical">
                    <Grid HorizontalAlignment="Stretch" Grid.ColumnDefinitions="*,*,*">
                        <StackPanel Grid.Column="0" Orientation="Vertical" Margin="0,0,8,0" HorizontalAlignment="Center">
                            <TextBlock HorizontalAlignment="Center" FontWeight="Bold" Text="Total"/>
                            <TextBlock HorizontalAlignment="Center" FontSize="24" Text="{Binding Q1TotalExamTime}"/>
                            <TextBlock HorizontalAlignment="Center" FontSize="36" Text="{Binding Q1MeanTotalExamTime}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Vertical" Margin="0,0,8,0" HorizontalAlignment="Center">
                            <TextBlock HorizontalAlignment="Center" FontWeight="Bold" Text="Middle Age"/>
                            <TextBlock HorizontalAlignment="Center" FontSize="24" Text="{Binding Q1TotalMiddleExamTime}"/>
                            <TextBlock HorizontalAlignment="Center" FontSize="36" Text="{Binding Q1MeanMiddleExamTime}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Vertical" Margin="0,0,8,0" HorizontalAlignment="Center">
                            <TextBlock HorizontalAlignment="Center" FontWeight="Bold" Text="Elderly"/>
                            <TextBlock HorizontalAlignment="Center" FontSize="24" Text="{Binding Q1TotalElderlyExamTime}"/>
                            <TextBlock HorizontalAlignment="Center" FontSize="36" Text="{Binding Q1MeanElderlyExamTime}"/>
                        </StackPanel>
                    </Grid>
                    <lvc:CartesianChart LegendPosition="Hidden"
                                        Background="Transparent"
                                        Height="300">
                        <lvc:CartesianChart.Series>
                            <lvc:SeriesCollection>
                                <lvc:XamlRowSeries
                                    Values="{Binding Q1ExamTimes}"
                                    DataLabelsPaint="{wpf:SolidColorPaint Color='#FFFFFF'}"
                                    SeriesName="Average Exam Time"
                                    MaxBarWidth="40"
                                    ShowDataLabels="True"
                                    DataLabelsPosition="End"
                                    DataLabelsSize="14"/>
                            </lvc:SeriesCollection>
                        </lvc:CartesianChart.Series>

                        <lvc:CartesianChart.XAxes>
                            <lvc:AxesCollection>
                                <lvc:XamlAxis
                                    LabelsPaint="{wpf:SolidColorPaint Color='#FFFFFF'}"
                                    NamePaint="{wpf:SolidColorPaint Color='#FFFFFF'}"
                                    AxisName="Minutes"
                                    MinLimit="0"/>
                            </lvc:AxesCollection>
                        </lvc:CartesianChart.XAxes>

                        <lvc:CartesianChart.YAxes>
                            <lvc:AxesCollection>
                                <lvc:XamlAxis
                                    LabelsPaint="{wpf:SolidColorPaint Color='#FFFFFF'}"
                                    Labels="{Binding Q1ExamTimeLabels}"/>
                            </lvc:AxesCollection>
                        </lvc:CartesianChart.YAxes>

                    </lvc:CartesianChart>
                    </StackPanel>
                </ui:Card>
            <TextBlock Text="Q2 Wait Average Time"
                       FontWeight="SemiBold" FontSize="14"
                       Margin="4,4,0,4"/>
            <ui:Card>
                <StackPanel Orientation="Vertical">
                <Grid HorizontalAlignment="Stretch" Grid.ColumnDefinitions="*,*,*">
                    <StackPanel Grid.Column="0" Orientation="Vertical" Margin="0,0,8,0" HorizontalAlignment="Center">
                        <TextBlock HorizontalAlignment="Center" FontWeight="Bold" Text="Total"/>
                        <TextBlock HorizontalAlignment="Center" FontSize="24" Text="{Binding Q2TotalWaitAverage}"/>
                        <wpf:PieChart
                            Background="Transparent"
                            Width="120"
                            Height="120"
                            Margin="0,8,0,0"
                            InitialRotation="-90"
                            MinValue="0"
                            MaxValue="1">

                            <wpf:PieChart.Series>
                                <wpf:SeriesCollection>

                                    <wpf:XamlGaugeSeries
                                        GaugeValue="{Binding Q2MeanWaitAverage}"
                                        DataLabelsSize="36"
                                        DataLabelsFormatter="{Binding GaugeFormatter}"
                                        DataLabelsPaint="{wpf:SolidColorPaint Color='#FFFFFF'}"
                                        MaxRadialColumnWidth="10"/>

                                    <wpf:XamlGaugeBackgroundSeries/>

                                </wpf:SeriesCollection>
                            </wpf:PieChart.Series>

                        </wpf:PieChart>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Vertical" Margin="0,0,8,0" HorizontalAlignment="Center">
                        <TextBlock HorizontalAlignment="Center" FontWeight="Bold" Text="Middle Age"/>
                        <TextBlock HorizontalAlignment="Center" FontSize="24" Text="{Binding Q2TotalWaitAverageMiddleAge}"/>
                        <wpf:PieChart
                            Background="Transparent"
                            Width="120"
                            Height="120"
                            Margin="0,8,0,0"
                            InitialRotation="-90"
                            MinValue="0"
                            MaxValue="1">

                            <wpf:PieChart.Series>
                                <wpf:SeriesCollection>

                                    <wpf:XamlGaugeSeries
                                        GaugeValue="{Binding Q2MeanWaitAverageMiddleAge}"
                                        DataLabelsSize="36"
                                        DataLabelsFormatter="{Binding GaugeFormatter}"
                                        DataLabelsPaint="{wpf:SolidColorPaint Color='#FFFFFF'}"
                                        MaxRadialColumnWidth="10"/>

                                    <wpf:XamlGaugeBackgroundSeries/>

                                </wpf:SeriesCollection>
                            </wpf:PieChart.Series>

                        </wpf:PieChart>   
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Vertical" Margin="0,0,8,0" HorizontalAlignment="Center">
                        <TextBlock HorizontalAlignment="Center" FontWeight="Bold" Text="Elderly"/>
                        <TextBlock HorizontalAlignment="Center" FontSize="24" Text="{Binding Q2TotalWaitAverageElderly}"/>
                        <wpf:PieChart
                            Background="Transparent"
                            Width="120"
                            Height="120"
                            Margin="0,8,0,0"
                            InitialRotation="-90"
                            MinValue="0"
                            MaxValue="1">

                            <wpf:PieChart.Series>
                                <wpf:SeriesCollection>

                                    <wpf:XamlGaugeSeries
                                        GaugeValue="{Binding Q2MeanWaitAverageElderly}"
                                        DataLabelsSize="36"
                                        DataLabelsFormatter="{Binding GaugeFormatter}"
                                        DataLabelsPaint="{wpf:SolidColorPaint Color='#FFFFFF'}"
                                        MaxRadialColumnWidth="10"/>

                                    <wpf:XamlGaugeBackgroundSeries/>

                                </wpf:SeriesCollection>
                            </wpf:PieChart.Series>

                        </wpf:PieChart>
                    </StackPanel>
                </Grid>
                    <lvc:CartesianChart LegendPosition="Hidden"
                                        Background="Transparent"
                                        Height="300">
                        <lvc:CartesianChart.Series>
                            <lvc:SeriesCollection>
                                <lvc:XamlRowSeries
                                    Values="{Binding Q2MeanWaitTimes}"
                                    DataLabelsPaint="{wpf:SolidColorPaint Color='#FFFFFF'}"
                                    SeriesName="Average Wait Time"
                                    MaxBarWidth="40"
                                    ShowDataLabels="True"
                                    DataLabelsPosition="End"
                                    DataLabelsSize="14"/>
                            </lvc:SeriesCollection>
                        </lvc:CartesianChart.Series>

                        <lvc:CartesianChart.XAxes>
                            <lvc:AxesCollection>
                                <lvc:XamlAxis
                                    LabelsPaint="{wpf:SolidColorPaint Color='#FFFFFF'}"
                                    NamePaint="{wpf:SolidColorPaint Color='#FFFFFF'}"
                                    AxisName="Minutes"
                                    MinLimit="0"/>
                            </lvc:AxesCollection>
                        </lvc:CartesianChart.XAxes>

                        <lvc:CartesianChart.YAxes>
                            <lvc:AxesCollection>
                                <lvc:XamlAxis
                                    LabelsPaint="{wpf:SolidColorPaint Color='#FFFFFF'}"
                                    Labels="{Binding Q1ExamTimeLabels}"/>
                            </lvc:AxesCollection>
                        </lvc:CartesianChart.YAxes>

                    </lvc:CartesianChart>
                </StackPanel>
            </ui:Card>
            
            <TextBlock Text="Q3 Maximum Queue Length"
                       FontWeight="SemiBold" FontSize="14"
                       Margin="4,4,0,4"/>
            <ui:Card>
                <StackPanel>
                <Grid HorizontalAlignment="Stretch" Grid.ColumnDefinitions="*,*,*">
                    <StackPanel Grid.Column="0" Orientation="Vertical" Margin="0,0,8,0" HorizontalAlignment="Center">
                        <TextBlock HorizontalAlignment="Center" FontWeight="Bold" Text="Nurse"/>
                        <TextBlock HorizontalAlignment="Center" FontSize="36" Text="{Binding Q3maxNurseQueue}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Vertical" Margin="0,0,8,0" HorizontalAlignment="Center">
                        <TextBlock HorizontalAlignment="Center" FontWeight="Bold" Text="Middle Age"/>
                        <TextBlock HorizontalAlignment="Center" FontSize="36" Text="{Binding Q3maxMiddleAgeQueue}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Vertical" Margin="0,0,8,0" HorizontalAlignment="Center">
                        <TextBlock HorizontalAlignment="Center" FontWeight="Bold" Text="Elderly"/>
                        <TextBlock HorizontalAlignment="Center" FontSize="36" Text="{Binding Q3maxElderlyQueue}"/>
                    </StackPanel>
                </Grid>
                    <lvc:CartesianChart LegendPosition="Hidden"
                                        Background="Transparent"
                                        Height="300">
                        <lvc:CartesianChart.Series>
                            <lvc:SeriesCollection>
                                <lvc:XamlRowSeries
                                    Values="{Binding Q3MaxQueue}"
                                    DataLabelsPaint="{wpf:SolidColorPaint Color='#FFFFFF'}"
                                    SeriesName="Max Queue Length"
                                    MaxBarWidth="40"
                                    ShowDataLabels="True"
                                    DataLabelsPosition="End"
                                    DataLabelsSize="14"/>
                            </lvc:SeriesCollection>
                        </lvc:CartesianChart.Series>

                        <lvc:CartesianChart.XAxes>
                            <lvc:AxesCollection>
                                <lvc:XamlAxis
                                    LabelsPaint="{wpf:SolidColorPaint Color='#FFFFFF'}"
                                    NamePaint="{wpf:SolidColorPaint Color='#FFFFFF'}"
                                    AxisName="Number of people in queue"
                                    MinLimit="0"/>
                            </lvc:AxesCollection>
                        </lvc:CartesianChart.XAxes>

                        <lvc:CartesianChart.YAxes>
                            <lvc:AxesCollection>
                                <lvc:XamlAxis
                                    LabelsPaint="{wpf:SolidColorPaint Color='#FFFFFF'}"
                                    Labels="{Binding Q1ExamTimeLabels}"/>
                            </lvc:AxesCollection>
                        </lvc:CartesianChart.YAxes>

                    </lvc:CartesianChart>
                </StackPanel>
            </ui:Card>
            
            <TextBlock Text="Q4 Wait probability"
                       FontWeight="SemiBold" FontSize="14"
                       Margin="4,4,0,4"/>
            <ui:Card>
                <Grid HorizontalAlignment="Stretch" Grid.ColumnDefinitions="*,*,*">
                    <StackPanel Grid.Column="0" Orientation="Vertical" Margin="0,0,8,0" HorizontalAlignment="Center">
                        <TextBlock HorizontalAlignment="Center" FontWeight="Bold" Text="Nurse"/>
                        <TextBlock HorizontalAlignment="Center" FontSize="24" Text="{Binding Q4NurseWaitCount}"/>
                        <wpf:PieChart
                            Background="Transparent"
                            Width="120"
                            Height="120"
                            Margin="0,8,0,0"
                            InitialRotation="-90"
                            MinValue="0"
                            MaxValue="1">

                            <wpf:PieChart.Series>
                                <wpf:SeriesCollection>

                                    <wpf:XamlGaugeSeries
                                        GaugeValue="{Binding Q4ProbNurseWait}"
                                        DataLabelsSize="36"
                                        DataLabelsFormatter="{Binding GaugeFormatterPercentages}"
                                        DataLabelsPaint="{wpf:SolidColorPaint Color='#FFFFFF'}"
                                        MaxRadialColumnWidth="10"/>

                                    <wpf:XamlGaugeBackgroundSeries/>

                                </wpf:SeriesCollection>
                            </wpf:PieChart.Series>

                        </wpf:PieChart>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Vertical" Margin="0,0,8,0" HorizontalAlignment="Center">
                        <TextBlock HorizontalAlignment="Center" FontWeight="Bold" Text="Doctor Middle Age"/>
                        <TextBlock HorizontalAlignment="Center" FontSize="24" Text="{Binding Q4middleDoctorWaitCount}"/>
                        <wpf:PieChart
                            Background="Transparent"
                            Width="120"
                            Height="120"
                            Margin="0,8,0,0"
                            InitialRotation="-90"
                            MinValue="0"
                            MaxValue="1">

                            <wpf:PieChart.Series>
                                <wpf:SeriesCollection>

                                    <wpf:XamlGaugeSeries
                                        GaugeValue="{Binding Q4ProbMiddleDoctorWait}"
                                        DataLabelsSize="36"
                                        DataLabelsFormatter="{Binding GaugeFormatterPercentages}"
                                        DataLabelsPaint="{wpf:SolidColorPaint Color='#FFFFFF'}"
                                        MaxRadialColumnWidth="10"/>

                                    <wpf:XamlGaugeBackgroundSeries/>

                                </wpf:SeriesCollection>
                            </wpf:PieChart.Series>

                        </wpf:PieChart>              
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Vertical" Margin="0,0,8,0" HorizontalAlignment="Center">
                        <TextBlock HorizontalAlignment="Center" FontWeight="Bold" Text=" Doctor Elderly"/>
                        <TextBlock HorizontalAlignment="Center" FontSize="24" Text="{Binding Q4ElderlyDoctorWaitCount}"/>
                        <wpf:PieChart
                            Background="Transparent"
                            Width="120"
                            Height="120"
                            Margin="0,8,0,0"
                            InitialRotation="-90"
                            MinValue="0"
                            MaxValue="1">

                            <wpf:PieChart.Series>
                                <wpf:SeriesCollection>

                                    <wpf:XamlGaugeSeries
                                        GaugeValue="{Binding Q4ProbElderlyDoctorWait}"
                                        DataLabelsSize="36"
                                        DataLabelsFormatter="{Binding GaugeFormatterPercentages}"
                                        DataLabelsPaint="{wpf:SolidColorPaint Color='#FFFFFF'}"
                                        MaxRadialColumnWidth="10"/>

                                    <wpf:XamlGaugeBackgroundSeries/>

                                </wpf:SeriesCollection>
                            </wpf:PieChart.Series>

                        </wpf:PieChart>              
                    </StackPanel>
                </Grid>
            </ui:Card>
            
            <TextBlock Text="Q5 Idle Time Portion"
                       FontWeight="SemiBold" FontSize="14"
                       Margin="4,4,0,4"/>
            <ui:Card>
                <Grid HorizontalAlignment="Stretch" Grid.ColumnDefinitions="*,*,*">
                    <StackPanel Grid.Column="0" Orientation="Vertical" Margin="0,0,8,0" HorizontalAlignment="Center">
                        <TextBlock HorizontalAlignment="Center" FontWeight="Bold" Text="Nurse"/>
                        <wpf:PieChart
                            Background="Transparent"
                            Width="120"
                            Height="120"
                            Margin="0,8,0,0"
                            InitialRotation="-90"
                            MinValue="0"
                            MaxValue="1">

                            <wpf:PieChart.Series>
                                <wpf:SeriesCollection>

                                    <wpf:XamlGaugeSeries
                                        GaugeValue="{Binding Q5PortionNurseIdleDouble}"
                                        DataLabelsSize="36"
                                        DataLabelsFormatter="{Binding GaugeFormatterPercentages}"
                                        DataLabelsPaint="{wpf:SolidColorPaint Color='#FFFFFF'}"
                                        MaxRadialColumnWidth="10"/>
                                    
                                    <wpf:XamlGaugeBackgroundSeries/>
                                    
                                </wpf:SeriesCollection>
                            </wpf:PieChart.Series>

                        </wpf:PieChart>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Vertical" Margin="0,0,8,0" HorizontalAlignment="Center">
                        <TextBlock HorizontalAlignment="Center" FontWeight="Bold" Text="Doctor Middle Age"/>
                        <wpf:PieChart
                            Background="Transparent"
                            Width="120"
                            Height="120"
                            Margin="0,8,0,0"
                            InitialRotation="-90"
                            MinValue="0"
                            MaxValue="1">

                            <wpf:PieChart.Series>
                                <wpf:SeriesCollection>

                                    <wpf:XamlGaugeSeries
                                        GaugeValue="{Binding Q5PortionMiddleDoctorIdleDouble}"
                                        DataLabelsSize="36"
                                        DataLabelsFormatter="{Binding GaugeFormatterPercentages}"
                                        DataLabelsPaint="{wpf:SolidColorPaint Color='#FFFFFF'}"
                                        MaxRadialColumnWidth="10"/>

                                    <wpf:XamlGaugeBackgroundSeries/>

                                </wpf:SeriesCollection>
                            </wpf:PieChart.Series>

                        </wpf:PieChart>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Vertical" Margin="0,0,8,0" HorizontalAlignment="Center">
                        <TextBlock HorizontalAlignment="Center" FontWeight="Bold" Text=" Doctor Elderly"/>
                        <wpf:PieChart
                            Background="Transparent"
                            Width="120"
                            Height="120"
                            Margin="0,8,0,0"
                            InitialRotation="-90"
                            MinValue="0"
                            MaxValue="1">

                            <wpf:PieChart.Series>
                                <wpf:SeriesCollection>

                                    <wpf:XamlGaugeSeries
                                        GaugeValue="{Binding Q5PortionElderlyDoctorIdleDouble}"
                                        DataLabelsSize="36"
                                        DataLabelsFormatter="{Binding GaugeFormatterPercentages}"
                                        DataLabelsPaint="{wpf:SolidColorPaint Color='#FFFFFF'}"
                                        MaxRadialColumnWidth="10"/>

                                    <wpf:XamlGaugeBackgroundSeries/>

                                </wpf:SeriesCollection>
                            </wpf:PieChart.Series>

                        </wpf:PieChart>
                    </StackPanel>
                </Grid>
            </ui:Card>
            <TextBlock Text="Q6 Theoretical vs Actual exam time"
                       FontWeight="SemiBold" FontSize="14"
                       Margin="4,4,0,4"/>
            <ui:Card>
                <StackPanel>
                <Grid HorizontalAlignment="Stretch" Grid.ColumnDefinitions="*,*,*,*,*">
                    <StackPanel Grid.Column="0" Orientation="Vertical" Margin="0,0,8,0" HorizontalAlignment="Center">
                        <TextBlock TextAlignment="left" FontWeight="Bold" Text="Type"/>
                        <TextBlock HorizontalAlignment="Left" FontSize="24" Padding="0,8" Text="Theoretical"/>
                        <Separator/>
                        <TextBlock HorizontalAlignment="left" FontSize="24" Padding="0,8" Text="Actual"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Vertical" Margin="0,0,8,0" HorizontalAlignment="Center">
                        <TextBlock HorizontalAlignment="Center" FontWeight="Bold" Text="Nurse Middle Age"/>
                        <TextBlock HorizontalAlignment="Center" FontSize="36" Text="{Binding Q6NurseTheoreticalMiddleAgeAvgTime}"/>
                        <Separator/>
                        <TextBlock HorizontalAlignment="Center" FontSize="36" Text="{Binding Q6NurseMiddleAgeAvgTime}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Vertical" Margin="0,0,8,0" HorizontalAlignment="Center">
                        <TextBlock HorizontalAlignment="Center" FontWeight="Bold" Text="Nurse Elderly"/>
                        <TextBlock HorizontalAlignment="Center" FontSize="36" Text="{Binding Q6NurseTheoreticalElderlyAvgTime}"/>
                        <Separator/>
                        <TextBlock HorizontalAlignment="Center" FontSize="36" Text="{Binding Q6NurseElderlyAvgTime}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="3" Orientation="Vertical" Margin="0,0,8,0" HorizontalAlignment="Center">
                        <TextBlock HorizontalAlignment="Center" FontWeight="Bold" Text="Doctor Middle Age"/>
                        <TextBlock HorizontalAlignment="Center" FontSize="36" Text="{Binding Q6DoctorTheoreticalMiddleAvgTime}"/>
                        <Separator/>
                        <TextBlock HorizontalAlignment="Center" FontSize="36" Text="{Binding Q1MeanMiddleExamTime}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="4" Orientation="Vertical" Margin="0,0,8,0" HorizontalAlignment="Center">
                        <TextBlock HorizontalAlignment="Center" FontWeight="Bold" Text=" Doctor Elderly"/>
                        <TextBlock HorizontalAlignment="Center" FontSize="36" Text="{Binding Q6DoctorTheoreticalElderlyAvgTime}"/>
                        <Separator/>
                        <TextBlock HorizontalAlignment="Center" FontSize="36" Text="{Binding Q1MeanElderlyExamTime}"/>
                    </StackPanel>
                </Grid>
                    <lvc:CartesianChart
                        Height="350"
                        Background="Transparent"
                        LegendPosition="Bottom"
                        LegendTextPaint="{wpf:SolidColorPaint Color='#FFFFFF'}"
                        DrawMarginFrame="{x:Null}">
                        <lvc:CartesianChart.Series>
                            <lvc:SeriesCollection>

                                <!-- Theoretical -->
                                <lvc:XamlRowSeries
                                    Values="{Binding Q6TheoreticalTimes}"
                                    DataLabelsPaint="{wpf:SolidColorPaint Color='#FFFFFF'}"
                                    SeriesName="Theoretical"
                                    MaxBarWidth="40"
                                    ShowDataLabels="True"
                                    DataLabelsPosition="End"
                                    DataLabelsSize="14"/>
                                
                                <lvc:XamlRowSeries
                                    Values="{Binding Q6ActualTimes}"
                                    DataLabelsPaint="{wpf:SolidColorPaint Color='#FFFFFF'}"
                                    SeriesName="Actual"
                                    MaxBarWidth="40"
                                    ShowDataLabels="True"
                                    DataLabelsPosition="End"
                                    DataLabelsSize="14"/>

                            </lvc:SeriesCollection>
                        </lvc:CartesianChart.Series>
                        <lvc:CartesianChart.XAxes>
                            <lvc:AxesCollection>
                                <lvc:XamlAxis
                                    AxisName="Minutes"
                                    MinLimit="0"
                                    TextSize="12"
                                    LabelsPaint="{lvc:SolidColorPaint Color=White}"
                                    NamePaint="{lvc:SolidColorPaint Color=White}"/>
                            </lvc:AxesCollection>
                        </lvc:CartesianChart.XAxes>

                        <!-- Y axis: Categories -->
                        <lvc:CartesianChart.YAxes>
                            <lvc:AxesCollection>
                                <lvc:XamlAxis
                                    LabelsPaint="{wpf:SolidColorPaint Color='#FFFFFF'}"
                                    Labels="{Binding Q6Labels}"/>
                            </lvc:AxesCollection>
                        </lvc:CartesianChart.YAxes>
                    </lvc:CartesianChart>
                </StackPanel>
            </ui:Card>
            
            <TextBlock Text="Q7 Theoretical vs Actual IAT"
                       FontWeight="SemiBold" FontSize="14"
                       Margin="4,4,0,4"/>
            <ui:Card>
                <StackPanel>
                <Grid HorizontalAlignment="Stretch" Grid.ColumnDefinitions="*,*,*">
                    <StackPanel Grid.Column="0" Orientation="Vertical" Margin="0,0,8,0" HorizontalAlignment="Center">
                        <TextBlock HorizontalAlignment="Center" FontWeight="Bold" Text="Theoretical"/>
                        <TextBlock HorizontalAlignment="Center" FontSize="36" Text="{Binding Q7TheoreticalIAT}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Vertical" Margin="0,0,8,0" HorizontalAlignment="Center">
                        <TextBlock HorizontalAlignment="Center" FontWeight="Bold" Text="Actual"/>
                        <TextBlock HorizontalAlignment="Center" FontSize="36" Text="{Binding Q7MeanIat}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Vertical" Margin="0,0,8,0" HorizontalAlignment="Center">
                        <TextBlock HorizontalAlignment="Center" FontWeight="Bold" Text="Error"/>
                        <TextBlock HorizontalAlignment="Center" FontSize="36" Text="{Binding Q7IATError}"/>
                    </StackPanel>
                </Grid>
                    <lvc:CartesianChart LegendPosition="Hidden"
                                        Background="Transparent"
                                        Height="300">
                        <lvc:CartesianChart.Series>
                            <lvc:SeriesCollection>
                                <lvc:XamlRowSeries
                                    Values="{Binding Q7IATTimes}"
                                    DataLabelsPaint="{wpf:SolidColorPaint Color='#FFFFFF'}"
                                    SeriesName="Times"
                                    MaxBarWidth="40"
                                    ShowDataLabels="True"
                                    DataLabelsPosition="End"
                                    DataLabelsSize="14"/>
                            </lvc:SeriesCollection>
                        </lvc:CartesianChart.Series>

                        <lvc:CartesianChart.XAxes>
                            <lvc:AxesCollection>
                                <lvc:XamlAxis
                                    LabelsPaint="{wpf:SolidColorPaint Color='#FFFFFF'}"
                                    NamePaint="{wpf:SolidColorPaint Color='#FFFFFF'}"
                                    AxisName="Minutes"
                                    MinLimit="0"/>
                            </lvc:AxesCollection>
                        </lvc:CartesianChart.XAxes>

                        <lvc:CartesianChart.YAxes>
                            <lvc:AxesCollection>
                                <lvc:XamlAxis
                                    LabelsPaint="{wpf:SolidColorPaint Color='#FFFFFF'}"
                                    Labels="{Binding Q7Labels}"/>
                            </lvc:AxesCollection>
                        </lvc:CartesianChart.YAxes>

                    </lvc:CartesianChart>
                </StackPanel>
            </ui:Card>
        </StackPanel>
    </Grid>
</Page>