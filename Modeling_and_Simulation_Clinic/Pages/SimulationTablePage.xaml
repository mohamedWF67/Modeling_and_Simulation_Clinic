<Page x:Class="Modeling_and_Simulation_Clinic.Pages.SimulationTablePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:vm="clr-namespace:Modeling_and_Simulation_Clinic.ViewModels"
      xmlns:componentModel="clr-namespace:System.ComponentModel;assembly=PresentationFramework"
      mc:Ignorable="d"
      d:DesignHeight="700"
      d:DesignWidth="900"
      d:DataContext="{d:DesignInstance vm:SimulationViewModel}"
      ScrollViewer.CanContentScroll="False"
      Title="Simulation table">
    <!-- CanContentScroll="False" turns off the NavigationView's page scroll viewer:
         the table fills the page and scrolls by itself (only visible rows are drawn). -->
    <Page.Resources>
        <Style x:Key="SimulationGrid" TargetType="{x:Type DataGrid}" BasedOn="{StaticResource {x:Type DataGrid}}">
            <Setter Property="ItemsSource" Value="{Binding Patients}" />
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="CanUserDeleteRows" Value="False" />
            <Setter Property="AlternatingRowBackground" Value="#484848"/>
            <Setter Property="CanUserReorderColumns" Value="False" />
            <Setter Property="CanUserResizeRows" Value="False" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="SelectionMode" Value="Single" />
            <!-- Patient and type stay visible while scrolling sideways -->
            <Setter Property="FrozenColumnCount" Value="2" />
            <Setter Property="EnableRowVirtualization" Value="True" />
            <Setter Property="EnableColumnVirtualization" Value="True" />
            <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
            <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
            <Setter Property="HorizontalScrollBarVisibility" Value="Auto" />
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="FontSize" Value="13" />
        </Style>

        <!-- "Left" in the doctor column is shown in red -->
        <Style x:Key="DoctorCellText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Left}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- One template per table. Only the chosen one is created, so its columns
             are always measured while visible. -->
        <DataTemplate x:Key="CombinedTable">
            <DataGrid Style="{StaticResource SimulationGrid}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Patient" Binding="{Binding Id}"/>
                    <DataGridTextColumn Header="Type" Binding="{Binding Type}"/>
                    <DataGridTextColumn Header="RN&#10;type" Binding="{Binding RnType}"/>
                    <DataGridTextColumn Header="RN&#10;IAT" Binding="{Binding RnIat, TargetNullValue=—}"/>
                    <DataGridTextColumn Header="IAT" Binding="{Binding Iat}"/>
                    <DataGridTextColumn Header="Arrival" Binding="{Binding Arrival}"/>
                    <DataGridTextColumn Header="Nurse&#10;start" Binding="{Binding NurseStart}"/>
                    <DataGridTextColumn Header="Nurse&#10;time" Binding="{Binding NurseTime}"/>
                    <DataGridTextColumn Header="Nurse&#10;end" Binding="{Binding NurseEnd}"/>
                    <DataGridTextColumn Header="Nurse&#10;wait" Binding="{Binding NurseWait}"/>
                    <DataGridTextColumn Header="RN&#10;exam" Binding="{Binding RnExam}"/>
                    <DataGridTextColumn Header="Exam&#10;time" Binding="{Binding ExamTime}"/>
                    <DataGridTextColumn Header="Doctor" Binding="{Binding Doctor}" ElementStyle="{StaticResource DoctorCellText}"/>
                    <DataGridTextColumn Header="Doctor&#10;start" Binding="{Binding DoctorStart, TargetNullValue=—}"/>
                    <DataGridTextColumn Header="Doctor&#10;end" Binding="{Binding DoctorEnd, TargetNullValue=—}"/>
                    <DataGridTextColumn Header="Doctor&#10;wait" Binding="{Binding DoctorWait}"/>
                    <DataGridTextColumn Header="RN&#10;leave" Binding="{Binding RnLeave, TargetNullValue=—}"/>
                    <DataGridTextColumn Header="Total&#10;wait" Binding="{Binding TotalWait}"/>
                    <DataGridTextColumn Header="Time in&#10;system" Binding="{Binding TimeInSystem}"/>
                </DataGrid.Columns>
            </DataGrid>
        </DataTemplate>

        <DataTemplate x:Key="NurseTable">
            <DataGrid Style="{StaticResource SimulationGrid}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Patient" Binding="{Binding Id}"/>
                    <DataGridTextColumn Header="Type" Binding="{Binding Type}"/>
                    <DataGridTextColumn Header="RN&#10;type" Binding="{Binding RnType}"/>
                    <DataGridTextColumn Header="RN&#10;IAT" Binding="{Binding RnIat, TargetNullValue=—}"/>
                    <DataGridTextColumn Header="IAT" Binding="{Binding Iat}"/>
                    <DataGridTextColumn Header="Arrival" Binding="{Binding Arrival}"/>
                    <DataGridTextColumn Header="Nurse&#10;start" Binding="{Binding NurseStart}"/>
                    <DataGridTextColumn Header="Nurse&#10;time" Binding="{Binding NurseTime}"/>
                    <DataGridTextColumn Header="Nurse&#10;end" Binding="{Binding NurseEnd}"/>
                    <DataGridTextColumn Header="Nurse&#10;wait" Binding="{Binding NurseWait}"/>
                </DataGrid.Columns>
            </DataGrid>
        </DataTemplate>

        <DataTemplate x:Key="DoctorTable">
            <DataGrid Style="{StaticResource SimulationGrid}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Patient" Binding="{Binding Id}"/>
                    <DataGridTextColumn Header="Type" Binding="{Binding Type}"/>
                    <DataGridTextColumn Header="Joins&#10;queue" Binding="{Binding NurseEnd}"/>
                    <DataGridTextColumn Header="RN&#10;exam" Binding="{Binding RnExam}"/>
                    <DataGridTextColumn Header="Exam&#10;time" Binding="{Binding ExamTime}"/>
                    <DataGridTextColumn Header="Doctor" Binding="{Binding Doctor}" ElementStyle="{StaticResource DoctorCellText}"/>
                    <DataGridTextColumn Header="Doctor&#10;start" Binding="{Binding DoctorStart, TargetNullValue=—}"/>
                    <DataGridTextColumn Header="Doctor&#10;end" Binding="{Binding DoctorEnd, TargetNullValue=—}"/>
                    <DataGridTextColumn Header="Doctor&#10;wait" Binding="{Binding DoctorWait}"/>
                    <DataGridTextColumn Header="RN&#10;leave" Binding="{Binding RnLeave, TargetNullValue=—}"/>
                    <DataGridTextColumn Header="Total&#10;wait" Binding="{Binding TotalWait}"/>
                    <DataGridTextColumn Header="Time in&#10;system" Binding="{Binding TimeInSystem}"/>
                </DataGrid.Columns>
            </DataGrid>
        </DataTemplate>
    </Page.Resources>

    <Grid>
        <Grid.Style>
            <Style TargetType="Grid">
                <Style.Triggers>
                    <Trigger Property="componentModel:DesignerProperties.IsInDesignMode" Value="True">
                        <Setter Property="Background" Value="Black"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
        </Grid.Style>
        <Grid Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Text="Simulation Table"
                       FontWeight="SemiBold" FontSize="18"
                       Margin="4,0,0,2"/>
            <TextBlock Grid.Row="1"
                       Text="{Binding Summary}"
                       Opacity="0.65"
                       TextWrapping="Wrap"
                       Margin="4,0,0,12"/>

            <ui:CardControl Grid.Row="2" Icon="{ui:SymbolIcon TableSimple20}" Margin="0,0,0,8">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock VerticalAlignment="Center" FontSize="14" TextWrapping="Wrap" Text="Table"/>
                        <TextBlock VerticalAlignment="Center" FontSize="12" Opacity="0.5" TextWrapping="Wrap" Text="The nurse part, the doctor part, or the whole patient flow in one table"/>
                    </StackPanel>
                </ui:CardControl.Header>
                <ComboBox Width="150"
                          SelectedIndex="{Binding SelectedTableIndex, Mode=TwoWay}">
                    <ComboBoxItem Content="Combined"/>
                    <ComboBoxItem Content="Nurse"/>
                    <ComboBoxItem Content="Doctors"/>
                </ComboBox>
            </ui:CardControl>

            <ui:Card Grid.Row="3"
                     Padding="4"
                     VerticalAlignment="Stretch"
                     VerticalContentAlignment="Stretch">
                <ContentControl Content="{Binding}"
                                Focusable="False"
                                HorizontalContentAlignment="Stretch"
                                VerticalContentAlignment="Stretch">
                    <ContentControl.Style>
                        <Style TargetType="ContentControl">
                            <Setter Property="ContentTemplate" Value="{StaticResource CombinedTable}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedTableIndex}" Value="1">
                                    <Setter Property="ContentTemplate" Value="{StaticResource NurseTable}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding SelectedTableIndex}" Value="2">
                                    <Setter Property="ContentTemplate" Value="{StaticResource DoctorTable}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ContentControl.Style>
                </ContentControl>
            </ui:Card>
        </Grid>
    </Grid>
</Page>
